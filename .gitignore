/tests/st/cases/*
!/tests/st/cases/coverage.json
!/tests/st/cases/correctness.json
!/tests/st/cases/mock.json
/tests/st/scripts/audit_history.py
/tests/st/scripts/official_mock.py
/tests/st/scripts/replay_history.py
/tests/st/scripts/source_preflight.py
/tests/st/scripts/sweep_mock.py
/tests/st/scripts/event_sweep.py
/tests/ut/test_official_mock.py
/docs/official_mock_workflow.md
/docs/performance_plan.md
/docs/experiments/

# Local optimization workspace (experiment records, tools, runs)
/optimization/
